# NVIDIA Nemotron LLM API Configuration (OpenAI-compatible NVIDIA NIM endpoint)
# Get your API key from NVIDIA Build: https://build.nvidia.com/
NEMOTRON_API_KEY=nvapi-your-key-here
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Optional Alternative Providers
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-2.0-flash

# Simulation Server Settings
VILLAGE_PORT=8000
VILLAGE_HOST=0.0.0.0

